{
  "schema_version": 4,
  "gates": [
    {
      "id": "GATE-BE-CONTRACT",
      "phase": "backend",
      "required": true,
      "description": "逐接口实际响应/错误与冻结OpenAPI一致"
    },
    {
      "id": "GATE-BE-RUNTIME",
      "phase": "backend",
      "required": false,
      "description": "真实MySQL迁移/恢复、Redis worker、Linux沙箱和外部服务验收",
      "acceptance_owner": "user",
      "defer_reason": "确认当前后端的验收进入到前端实现。我会在整个项目实现完成之后自己进行测试验收",
      "waiver_reason": "确认当前后端的验收进入到前端实现。我会在整个项目实现完成之后自己进行测试验收"
    },
    {
      "id": "GATE-BE-HANDOFF",
      "phase": "backend",
      "required": true,
      "description": "后端实现及本地独立检查完成，用户接受当前交接；真实外部模型/Tavily/LLM评估保留未验证并交用户最终验收；逐接口清单与运行说明齐全"
    },
    {
      "id": "GATE-FE-BUILD",
      "phase": "frontend",
      "required": true,
      "description": "两个Vue项目类型检查及独立生产构建通过"
    },
    {
      "id": "GATE-FE-UX",
      "phase": "frontend",
      "required": true,
      "description": "真实API、移动端、键盘及批准原型交互检查通过"
    },
    {
      "id": "GATE-SYSTEM-E2E",
      "phase": "integration",
      "required": true,
      "description": "真实采集/模型/发布、调度重投和双端业务链路通过"
    },
    {
      "id": "GATE-ENGINEERING-REVIEW",
      "phase": "integration",
      "required": true,
      "description": "需求及代码审查阻塞项清零"
    }
  ]
}
