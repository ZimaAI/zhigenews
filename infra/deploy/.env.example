# Server /opt/zhigenews/.env; infrastructure values only.
# Bare domain names; no scheme or trailing slash.
USER_DOMAIN=news.example.com
ADMIN_DOMAIN=admin.example.com
ACME_EMAIL=ops@example.com
# Generate each independently with: openssl rand -hex 32
# Hex passwords avoid URL escaping in DATABASE_URL.
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# Change all four together if this subnet conflicts with the host/VPN.
DOCKER_SUBNET=172.30.0.0/24
DOCKER_IP_RANGE=172.30.0.128/25
CADDY_IP=172.30.0.2
TRUSTED_PROXY_CIDRS=["172.30.0.2/32"]
SANDBOX_IMAGE=python:3.12-slim@sha256:78387bc3881b8273120a12ebe6c1ab22b018ccc2c9adf565ae1ac9b536e184ea
