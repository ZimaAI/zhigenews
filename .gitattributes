# Checkpoints hash raw bytes; preserve the line endings used by the Windows workflow.
.project-flow/versions/*/checkpoints/**/*.json text eol=lf
.project-flow/versions/*/checkpoints/**/*.md text eol=crlf

# Deployment files are executed on Linux, including Windows checkouts.
infra/deploy/** text eol=lf
.github/workflows/** text eol=lf

# The API generator hashes raw contract bytes and compares generated text exactly.
backend/src/zhigenews/contracts/openapi.json text eol=lf
packages/api-client/src/generated.ts text eol=lf
