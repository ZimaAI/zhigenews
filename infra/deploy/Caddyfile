{
	email {$ACME_EMAIL}
}

(application) {
	@backend path /api /api/* /healthz
	handle @backend {
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}

	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		try_files {path} /index.html
		header Cache-Control "no-cache"
		file_server
	}
}

{$USER_DOMAIN} {
	root * /srv/user
	import application
}

{$ADMIN_DOMAIN} {
	root * /srv/admin
	import application
}

# Container liveness only; public /healthz also checks the API and database.
:8080 {
	respond /healthz "ok" 200
}
