{
	servers {
		trusted_proxies static {$EDGE_PROXY_CIDRS}
		trusted_proxies_strict
	}
}

(application) {
	@backend path /api /api/* /healthz
	handle @backend {
		reverse_proxy api:8000 {
			# Send the resolved client alone: the API trusts only this Caddy.
			header_up X-Forwarded-For {client_ip}
			flush_interval -1
		}
	}

	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		try_files {path} /index.html
		header Cache-Control "no-cache"
		file_server
	}
}

http://{$USER_DOMAIN} {
	root * /srv/user
	import application
}

http://{$ADMIN_DOMAIN} {
	root * /srv/admin
	import application
}

:8080 {
	respond /healthz "ok" 200
}
