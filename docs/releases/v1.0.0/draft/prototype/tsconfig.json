{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "skipLibCheck": true, "esModuleInterop": true,
    "resolveJsonModule": true, "lib": ["ES2022", "DOM"],
    "types": ["vite/client", "node"],
    "baseUrl": ".", "paths": {"@shared/*": ["shared/*"]}
  },
  "include": ["shared/**/*.ts", "shared/**/*.vue", "user-web/**/*.ts", "user-web/**/*.vue", "admin-web/**/*.ts", "admin-web/**/*.vue"]
}
