# Server /opt/zhigenews/backend.env, loaded as raw key=value (no wrapping quotes).
# Generate Fernet key using the command in docs/deployment.md.
SECRET_ENCRYPTION_KEY=
IP_HASH_KEY=
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
OPENAI_API_KEY=
OPENAI_CONTEXT_WINDOW=258000
OPENAI_THINKING_ENABLED=false
TAVILY_API_KEY=
# Optional SUMMARY_OPENAI_*: see backend/.env.example.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=zhigenews-production
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_WORKSPACE_ID=
