# Copy to .env for local development. Never commit real credentials.
DATABASE_URL=mysql+pymysql://zhigenews:local-development@127.0.0.1:13316/zhigenews
REDIS_URL=redis://127.0.0.1:56386/0
DATA_DIR=./data
COOKIE_SECURE=false
ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://127.0.0.1:5174","http://localhost:5173","http://localhost:5174"]
# Generate with: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_ENCRYPTION_KEY=
IP_HASH_KEY=
ADMIN_EMAIL=admin@localhost.test
ADMIN_PASSWORD=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
OPENAI_API_KEY=
OPENAI_CONTEXT_WINDOW=32768
OPENAI_THINKING_ENABLED=false
# Optional summary model overrides; omitted values inherit the main model.
# SUMMARY_OPENAI_BASE_URL=https://api.openai.com/v1
# SUMMARY_OPENAI_MODEL=
# SUMMARY_OPENAI_API_KEY=
# SUMMARY_OPENAI_CONTEXT_WINDOW=32768
# SUMMARY_OPENAI_THINKING_ENABLED=false
# Optional evaluation judge: set its model to enable LLM scoring.
# Without EVALUATION_OPENAI_MODEL, evaluation uses rule-based scores only.
# Other omitted judge settings inherit the main model.
# EVALUATION_OPENAI_BASE_URL=https://api.openai.com/v1
# EVALUATION_OPENAI_MODEL=
# EVALUATION_OPENAI_API_KEY=
# EVALUATION_OPENAI_CONTEXT_WINDOW=32768
# EVALUATION_OPENAI_THINKING_ENABLED=false
# Restart gateway and workers after changing model settings.
# Agent limits, tools and system prompt live in src/zhigenews/runtime_config.py.
TAVILY_API_KEY=
# LangSmith: set a key to activate tracing; false disables all application traces.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=my-first-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Required only for an organization-scoped API key.
LANGSMITH_WORKSPACE_ID=
NEWSNOW_BASE_URL=https://newsnow.busiyi.world
SANDBOX_IMAGE=python:3.12-slim@sha256:78387bc3881b8273120a12ebe6c1ab22b018ccc2c9adf565ae1ac9b536e184ea
TRUSTED_PROXY_CIDRS=[]
