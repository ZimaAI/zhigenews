{
  "schema_version": 4,
  "gates": [
    {
      "id": "GATE-BE-CONTRACT",
      "phase": "backend",
      "required": true,
      "description": "逐接口实际响应/错误与冻结OpenAPI一致"
    },
    {
      "id": "GATE-BE-RUNTIME",
      "phase": "backend",
      "required": true,
      "description": "真实MySQL迁移/恢复、Redis worker、Linux沙箱和外部服务验收"
    },
    {
      "id": "GATE-BE-HANDOFF",
      "phase": "backend",
      "required": true,
      "description": "全部后端验收通过、逐接口清单和可重复运行交接齐全"
    },
    {
      "id": "GATE-FE-BUILD",
      "phase": "frontend",
      "required": true,
      "description": "两个Vue项目类型检查及独立生产构建通过"
    },
    {
      "id": "GATE-FE-UX",
      "phase": "frontend",
      "required": true,
      "description": "真实API、移动端、键盘及批准原型交互检查通过"
    },
    {
      "id": "GATE-SYSTEM-E2E",
      "phase": "integration",
      "required": true,
      "description": "真实采集/模型/发布、调度重投和双端业务链路通过"
    },
    {
      "id": "GATE-ENGINEERING-REVIEW",
      "phase": "integration",
      "required": true,
      "description": "需求及代码审查阻塞项清零"
    }
  ]
}
